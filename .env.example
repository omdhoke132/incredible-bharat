# Copy this file to .env for local development. Never commit real API keys.
OPENAI_API_KEY=replace_with_your_own_key
OPENAI_MODEL=gpt-4.1-mini
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=10

# For a separately hosted frontend, set this at FRONTEND BUILD TIME to the backend origin.
# Leave blank when frontend and backend share one origin.
VITE_API_BASE_URL=
